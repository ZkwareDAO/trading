# =============================================================================
# 环境变量示例 - 复制为 .env 并填写实际值
# =============================================================================
# 系统配置（config/settings.yaml, config/backtest.yaml）通过 ${VAR} 引用本文件变量。
# 加载方式：source .env && python run_strategies_manager.py
# =============================================================================

# ---- 数据管理器 ----
# K 线数据存储路径
DATA_PATH=/path/to/your/klines/data
# 实时 K 线 WebSocket / HTTP 服务地址
# 留空（或不设置）则回退到 Binance 公共源：
#   实时: wss://fstream.binance.com  历史: https://fapi.binance.com
KLINES_WS_URL=ws://127.0.0.1:17081/ws/klines
KLINES_HTTP_URL=http://127.0.0.1:17081

# ---- 策略引擎 ----
# factory-service 地址（策略注册/心跳）
FACTORY_ENDPOINT=http://127.0.0.1:8888
# Position 代理地址（远程仓位查询）
POSITION_PROXY_URL=http://127.0.0.1:8889

# ---- 信号推送 ----
# Signal Hub 服务地址
SIGNAL_HUB_ENDPOINT=http://127.0.0.1:18888
# Kafka 集群地址（signal_logging.kafka 启用时使用）
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# ---- 代理（访问 Binance 公共源时使用，国内网络通常需要）----
# 留空则直连。Binance 回退的 HTTP(WS) 都会读这两个变量。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
