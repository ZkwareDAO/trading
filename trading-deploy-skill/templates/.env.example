# ===== 必需配置 =====
STRATEGIES_GIT_URL=git@github.com:user/cta-strategies.git
STRATEGIES_DIR=./strategies
DATA_PATH=./data
KLINE_DATA_DIR=./data/strategies/1m
LOGS_DIR=./logs
DEPLOY_OUTPUTS_DIR=./deploy_outputs
PYTHON_CMD=python3

# ===== Git =====
GIT_BRANCH=main

# ===== WebSocket =====
WS_URL=wss://stream.binance.com:9443/ws
REST_URL=https://api.binance.com
WS_PING_INTERVAL=180
WS_RECONNECT_DELAY=5

# ===== 策略运行 =====
DEFAULT_CAPITAL=10000
DEFAULT_LEVERAGE=1
MAX_POSITIONS=3
POSITION_SIZE_PCT=0.1

# ===== 远程部署（可选） =====
# DEPLOY_TARGET=remote
# DEPLOY_HOST=
# DEPLOY_PORT=22
# DEPLOY_USER=
# DEPLOY_KEY=~/.ssh/id_rsa
