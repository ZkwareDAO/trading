# ===== 必需配置 =====
STRATEGIES_GIT_URL=git@github.com:user/cta-strategies.git
# CTA 项目根目录（含 run_strategy.py / config/ / strategies/）
PROJECT_DIR=/path/to/your/cta_project
STRATEGIES_DIR=./strategies
DATA_PATH=./data
KLINE_DATA_DIR=./data/klines
LOGS_DIR=./logs
DEPLOY_OUTPUTS_DIR=./deploy_outputs
# Python 命令。留空则自动探测 $PROJECT_DIR/.venv/bin/python → python3 → python
PYTHON_CMD=

# ===== Git =====
GIT_BRANCH=main

# ===== WebSocket =====
WS_URL=wss://stream.binance.com:9443/ws
REST_URL=https://api.binance.com
WS_PING_INTERVAL=180
WS_RECONNECT_DELAY=5

# ===== 策略运行 =====
# 运行模式：留空则由 strategies/<name>/overrides/<SYMBOL>.yaml 决定，
# 而该文件缺省 trading_mode 时框架按 live 处理（会下真单）。
# 首次部署建议显式设为 paper_trading 或 smoking。
TRADING_MODE=
# 资金/杠杆/仓位等策略参数不在此配置 ——
# 唯一来源是 strategies/<name>/overrides/<SYMBOL>.yaml 的 capital / risk 段。
# 在这里设置不会有任何效果。

# ===== 远程部署（可选） =====
# DEPLOY_TARGET=remote
# DEPLOY_HOST=
# DEPLOY_PORT=22
# DEPLOY_USER=
# DEPLOY_KEY=~/.ssh/id_rsa
