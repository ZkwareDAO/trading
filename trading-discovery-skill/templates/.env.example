# ===== 必需配置 =====
# CTA 项目根目录（含 backtest/strategy_core/data_manager 等）
PROJECT_DIR=/path/to/your/cta_project
DATA_PATH=./data
KLINE_DATA_DIR=./data/klines
STRATEGIES_DIR=./strategies
DISCOVERY_OUTPUTS_DIR=./discovery_outputs
LOGS_DIR=./logs
# Python 命令。留空则自动探测 $PROJECT_DIR/.venv/bin/python → python3 → python
# （模板依赖装在 .venv 里，且不少环境没有 python3 这个名字）
PYTHON_CMD=

# ===== 回测运行参数（可选，写入自动生成的 run-profile） =====
# run-profile 名，生成 $PROJECT_DIR/config/<name>.yaml，运行结束自动删除
DISCOVERY_PROFILE=discovery
BT_CASH=5000
BT_COMMISSION=0.0004
