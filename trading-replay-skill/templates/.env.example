# ===== 必需配置 =====
DATA_PATH=./data
KLINE_DATA_DIR=./data/strategies/1m
SNAPSHOT_DIR=./snapshot
LOGS_DIR=./logs
REPLAY_OUTPUTS_DIR=./replay_outputs
PYTHON_CMD=python3

# ===== 远程同步配置 =====
# 实盘机器 IP
SCP_HOST=your-server-ip
# SSH 端口
SCP_PORT=22
# SSH 用户名
SCP_USER=trader
# 实盘项目根目录（如 /home/trader/your_project）
SCP_PROJECT_DIR=/path/to/your/cta_project
# SSH 私钥路径
SCP_KEY=~/.ssh/id_rsa
# 超时（秒）
SCP_TIMEOUT=30
# 重试次数
SCP_RETRY=3
