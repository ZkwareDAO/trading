# ===== 必需配置 =====
DATA_PATH=./data
KLINE_DATA_DIR=./data/klines
SNAPSHOT_DIR=./snapshot
LOGS_DIR=./logs
REPLAY_OUTPUTS_DIR=./replay_outputs
# Python 命令。留空则自动探测 ./.venv/bin/python → python3 → python
# （快照排除了 .venv，用本机 Replay 项目的 .venv 跑快照代码）
PYTHON_CMD=

# ===== 回测运行参数（可选，写入自动生成的 run-profile） =====
# run-profile 名，在每个快照目录内生成 config/<name>.yaml，运行结束自动删除
REPLAY_PROFILE=replay
# --start 未指定时的回看天数
LOOKBACK_DAYS=30
BT_CASH=5000
BT_COMMISSION=0.0004

# ===== 远程同步配置 =====
# 实盘机器 IP
SCP_HOST=your-server-ip
# SSH 端口
SCP_PORT=22
# SSH 用户名
SCP_USER=trader
# 实盘项目根目录（如 /home/trader/your_project）
SCP_PROJECT_DIR=/path/to/your/cta_project
# SSH 私钥路径
SCP_KEY=~/.ssh/id_rsa
# 超时（秒）
SCP_TIMEOUT=30
# 重试次数
SCP_RETRY=3
